<infinispan xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="urn:infinispan:config:16.0 https://infinispan.org/schemas/infinispan-config-16.0.xsd
                          urn:infinispan:server:16.0 https://infinispan.org/schemas/infinispan-server-16.0.xsd"
      xmlns="urn:infinispan:config:16.0"
      xmlns:server="urn:infinispan:server:16.0">

   <cache-container name="default" statistics="true">
      <!-- Authentication only (SASL/SCRAM); no cache-container <authorization>
           (RBAC), so any authenticated user may create/use caches. -->

      <transport cluster="${infinispan.cluster.name:cluster}" stack="${infinispan.cluster.stack:tcp}"/>

      <distributed-cache-configuration name="org.infinispan.DIST_SYNC" mode="SYNC">
         <encoding media-type="application/octet-stream"/>
      </distributed-cache-configuration>

      <!-- Pre-defined cache the auth integration test targets, so the test needs
           no admin CLI round-trip to create one on a secured server. -->
      <distributed-cache name="authcache" mode="SYNC">
         <encoding media-type="application/octet-stream"/>
      </distributed-cache>
   </cache-container>

   <server xmlns="urn:infinispan:server:16.0">
      <interfaces>
         <interface name="public">
            <inet-address value="${infinispan.bind.address:0.0.0.0}"/>
         </interface>
      </interfaces>

      <socket-bindings default-interface="public" port-offset="${infinispan.socket.binding.port-offset:0}">
         <socket-binding name="default" port="${infinispan.bind.port:11222}"/>
      </socket-bindings>

      <security>
         <security-realms>
            <!-- Properties realm with PLAIN-TEXT passwords so the SCRAM family
                 (which derives keys from the cleartext password) can authenticate.
                 Non-default filenames (test-*.properties) avoid clashing with the
                 image entrypoint's auto-generated conf/users.properties. -->
            <security-realm name="default">
               <properties-realm groups-attribute="Roles">
                  <user-properties path="test-users.properties" plain-text="true"/>
                  <group-properties path="test-groups.properties"/>
               </properties-realm>
            </security-realm>
         </security-realms>
      </security>

      <endpoints>
         <endpoint socket-binding="default" security-realm="default">
            <hotrod-connector>
               <authentication>
                  <sasl mechanisms="SCRAM-SHA-512 SCRAM-SHA-256 SCRAM-SHA-1 PLAIN"
                        server-name="infinispan"/>
               </authentication>
            </hotrod-connector>
            <!-- Single-port endpoint requires a REST route even though these
                 tests only exercise Hot Rod SASL. -->
            <rest-connector/>
         </endpoint>
      </endpoints>
   </server>
</infinispan>
